<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Umbraco AI Carbon — Core</Title>
    <Description>Core services for Umbraco AI Carbon.</Description>
    <Company>Matt Brailsford</Company>
    <Authors>Matt Brailsford</Authors>
    <Copyright>Copyright © Matt Brailsford $([System.DateTime]::Today.ToString('yyyy'))</Copyright>
    <Product>Umbraco AI Carbon</Product>
    <PackageProjectUrl>https://github.com/mattbrailsford/Umbraco.Community.AI.Carbon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mattbrailsford/Umbraco.Community.AI.Carbon</RepositoryUrl>
    <PackageTags>umbraco ai carbon co2 sustainability umbraco-marketplace</PackageTags>
  </PropertyGroup>

  <!-- Takes Umbraco.AI as an ordinary NuGet package reference (version range), the same direction
       any third-party consumer of Umbraco.AI would: never a project reference across repos. -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.AI.Core" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Test.AI.Carbon.Unit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.Test.AI.Carbon.Integration</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- EcoLogits 0.11.2 reference data (MPL-2.0, unmodified; see Data/EcoLogits/NOTICE.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Data\EcoLogits\models.json" LogicalName="Umbraco.Community.AI.Carbon.Core.Data.EcoLogits.models.json" />
    <EmbeddedResource Include="Data\EcoLogits\electricity_mixes.json" LogicalName="Umbraco.Community.AI.Carbon.Core.Data.EcoLogits.electricity_mixes.json" />
  </ItemGroup>

  <!-- MPL-2.0 section 3.2: ship the notice alongside the binary distribution. -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

</Project>
